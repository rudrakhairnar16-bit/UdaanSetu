# UdaanSetu Environment Configuration
# Copy this file to .env and update values

# Database
POSTGRES_DB=udaansetu
POSTGRES_USER=udaansetu
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgresql+psycopg://udaansetu:change-me@db:5432/udaansetu

# JWT Secret — REQUIRED in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret

# Ollama AI (optional)
OLLAMA_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:8b

# Frontend API URL (set to your production domain)
NEXT_PUBLIC_API_URL=http://localhost:8080

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Token Expiry (hours)
JWT_EXPIRY_HOURS=12
