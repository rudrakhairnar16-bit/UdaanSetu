# ═══════════════════════════════════════════════
# UdaanSetu Production Environment — AWS EC2
# Copy to .env and fill in real values
# ═══════════════════════════════════════════════

# ── Database ──
POSTGRES_DB=udaansetu
POSTGRES_USER=udaansetu
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Backend ──
DATABASE_URL=postgresql+psycopg://udaansetu:CHANGE_ME_STRONG_PASSWORD@db:5432/udaansetu
SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
OLLAMA_ENABLED=false
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP,http://YOUR_DOMAIN
JWT_EXPIRY_HOURS=12

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP:8080
